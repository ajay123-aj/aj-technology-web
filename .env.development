# Dev server port — applied via `scripts/dev.cjs` before `next dev` (Next ignores this if you run `next dev` directly).
PORT=4000

# Local backend for lead collect (next dev only). Override in .env.local if needed.
NEXT_PUBLIC_LEADS_COLLECT_URL=https://aj-api.ajtechhub.com/api-backend/api/aj-web/leads/collect

# Contact form proxy target (server-side). Defaults to swapping /leads/collect → /contacts on the URL above if unset.
AJ_WEB_CONTACTS_API_URL=https://aj-api.ajtechhub.com/api-backend/api/aj-web/contacts
